{
  "name": "vradavan-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/generate-prisma.js && next build",
    "postinstall": "node scripts/generate-prisma.js",
    "start": "next start",
    "lint": "eslint",
    "db:generate": "node scripts/generate-prisma.js",
