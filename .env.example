# Vrindavan App - Environment Configuration

# Database (PostgreSQL / Supabase / Neon)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/vradavan_db?schema=public"

# Direct URL for migrations (if using connection pooling like Supabase PgBouncer)
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/vradavan_db?schema=public"

# JWT Authentication Secret (Used for role-based sessions)
AUTH_SECRET="vrindavan_super_secret_jwt_key_change_in_production_2026_xyz"

# Base Application URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Razorpay Payment Gateway Credentials (Test/Live)
# Replace with your Razorpay Dashboard keys (https://dashboard.razorpay.com/app/keys)
RAZORPAY_KEY_ID="rzp_test_placeholder_key_id"
RAZORPAY_KEY_SECRET="placeholder_razorpay_secret"
RAZORPAY_WEBHOOK_SECRET="placeholder_webhook_secret"

# Business Default Profile
NEXT_PUBLIC_DEFAULT_BUSINESS_SLUG="vrindavan-sweets"
